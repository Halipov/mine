{
  "name": "mine-launcher",
  "version": "0.1.4",
  "description": "Простой лаунчер модифицированного Minecraft для игры с друзьями",
  "main": "./out/main/index.js",
  "license": "MIT",
  "author": "y.khalipau",
  "scripts": {
    "dev": "node scripts/run.mjs electron-vite dev",
    "build": "electron-vite build",
    "start": "node scripts/run.mjs electron-vite preview",
    "selftest": "electron-vite build && node scripts/run.mjs electron . --selftest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack:win": "electron-vite build && electron-builder --win --publish never",
    "pack:mac": "electron-vite build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "prismarine-nbt": "^2.7.0",
    "tar": "^7.4.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
